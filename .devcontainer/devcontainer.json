{
	"name": "chardet",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.13",
	"features": {
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
	},
	"postCreateCommand": "uv sync; uv pip install .",
	"customizations": {
		"vscode": {
			"extensions": [
				"hbenl.vscode-test-explorer",
				"ms-python.python"
			]
		}
	}
}
